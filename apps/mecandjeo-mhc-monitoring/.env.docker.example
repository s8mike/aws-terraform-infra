APP_ENV=dev
APP_PROJECT_NAME=mecandjeo-mhc-monitoring
APP_VERSION=0.1.0
APP_PORT=8004

DATABASE_URL=postgresql+psycopg2://crane_user:crane_password@crane-db:5432/crane_monitoring
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
JWT_EXPIRE_HOURS=24
AUTO_CREATE_SCHEMA=false

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace=with=admin=password
SEED_SAMPLE_DATA=true

POSTGRES_IMAGE=postgres
POSTGRES_VERSION=17
POSTGRES_DB=crane_monitoring
POSTGRES_USER=crane_user
POSTGRES_PASSWORD=crane_password

IMAGE_NAME=mecandjeo-mhc-monitoring
IMAGE_TAG=dev

WEB_PORT=8080

RUN_BOOTSTRAP=true
